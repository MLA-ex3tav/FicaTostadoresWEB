rules_version = '2';

// Reglas alineadas con la app web + delete en solicitudes para sync de la app Electron.
// Publicar en Firebase Console → Firestore → Reglas (proyecto fica-tostadores).
service cloud.firestore {
  match /databases/{database}/documents {
    // El rol del equipo vive únicamente en `staff` (solo Admin SDK).
    function callerRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : null;
    }

    function isStaff() {
      return request.auth != null && callerRole() in ['editor', 'admin'];
    }

    match /clientes/{userId} {
      // Cada usuario solo puede leer su propio perfil.
      // El panel admin accede vía Admin SDK (no por estas reglas).
      allow read: if request.auth != null && request.auth.uid == userId;

      // `clientes` solo guarda el perfil de despacho. Los roles viven en `staff`.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role == 'cliente'
        );

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('role', null) == resource.data.get('role', null);

      allow delete: if false;
    }

    // Equipo y sus invitaciones: acceso exclusivo vía Admin SDK.
    match /staff/{userId} {
      allow read, write: if false;
    }

    match /staff_invitaciones/{invitacionId} {
      allow read, write: if false;
    }

    // Solicitudes desde la web pública (creación vía Admin SDK).
    // Electron: leer, actualizar y eliminar (sync local delete_pending).
    match /solicitudes_cotizacion/{solicitudId} {
      allow read, update, delete: if isStaff();
      allow read: if request.auth != null
        && resource.data.clientUserId == request.auth.uid;
      allow create: if false;
    }

    // Servicio técnico (mismo patrón que cotizaciones; creación vía Admin SDK).
    match /solicitudes_soporte_tecnico/{solicitudId} {
      allow read, update, delete: if isStaff();
      allow create: if false;
    }

    // Catálogo público (escritura solo vía Admin SDK en API routes).
    match /productos/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /catalogo_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Operadores de revisión: solo accesibles vía Admin SDK (API admin/electron).
    // El PIN nunca se expone al cliente.
    match /operadores/{operadorId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
